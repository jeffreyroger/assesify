# Assesify — environment configuration template.
#
# Copy to `.env` and fill in real values:  cp .env.example .env
# `.env` is gitignored and must never be committed.
#
# Every variable the application actually reads is listed here. Anything left
# unset falls back to an insecure development default, which is allowed ONLY
# while APP_ENV is not "production". Set APP_ENV=production and the app will
# refuse to start until the four secrets in the REQUIRED section are real.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# "development" (default) | "production"
# "production" turns the insecure-default fallbacks below into hard startup errors.
APP_ENV=development

# ---------------------------------------------------------------------------
# REQUIRED IN PRODUCTION — no safe default exists for any of these.
# Generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ---------------------------------------------------------------------------
# Flask session signing key.
SECRET_KEY=replace-me-with-a-generated-secret

# Signs and verifies JWTs. Anyone holding this can forge any user's token.
JWT_SECRET_KEY=replace-me-with-a-generated-secret

# Encrypts `users.email` / `users.full_name` at rest (spec §8).
PII_ENCRYPTION_KEY=replace-me-with-a-generated-secret

# Keys the deterministic HMAC used to look users up by email.
# WARNING: set this ONCE and keep it stable. Changing it re-keys every stored
# lookup hash, which locks out every existing user.
PII_LOOKUP_HASH_SECRET=replace-me-with-a-generated-secret

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Used by docker-compose to provision the Postgres container.
DB_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=assesify

# Read by the backend. Host/port/credentials must match the values above.
# Note: spec §11.3 specifies the psycopg driver — `postgresql+psycopg://` —
# whereas plain `postgresql://` uses whichever DBAPI is installed. Pick the one
# matching your installed driver.
DATABASE_URL=postgresql://postgres:replace-me@localhost:5433/assesify

# ---------------------------------------------------------------------------
# CORS / frontend
# ---------------------------------------------------------------------------
# When set, CORS is restricted to exactly this origin (with credentials).
# When unset, CORS is permissive — acceptable for local dev only.
FRONTEND_URL=http://localhost:3000

# Base URL the browser uses to reach the API. Must be reachable from the
# client, not just from the server. Falls back to http://127.0.0.1:5000.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# ---------------------------------------------------------------------------
# OPTIONAL — Google Gemini (spec §5.1)
# Without a key, quiz generation falls back to the rule-based generator.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------------------
# OPTIONAL — iGOT Karmayogi integration (spec §6)
# Unconfigured, the connector returns a clean 503 and recommendations fall back
# to internal remedial quizzes (spec §6.4). It never fabricates a result.
# KARMAYOGI_REDIRECT_URI must exactly match the URI registered with Karmayogi,
# or the PKCE authorization-code flow will be rejected.
# ---------------------------------------------------------------------------
KARMAYOGI_BASE_URL=
KARMAYOGI_CLIENT_ID=
KARMAYOGI_CLIENT_SECRET=
KARMAYOGI_AUTH_URL=
KARMAYOGI_TOKEN_URL=
KARMAYOGI_USERINFO_URL=
KARMAYOGI_REDIRECT_URI=http://localhost:3000/auth/karmayogi/callback
KARMAYOGI_SCOPE=openid profile
# Competency taxonomy cache lifetime, in seconds (spec §6.3 default: 24h).
KARMAYOGI_COMPETENCY_CACHE_TTL=86400
# Optional JSON overriding competency_tag -> Karmayogi competency id mapping.
KARMAYOGI_COMPETENCY_MAP=

# ---------------------------------------------------------------------------
# OPTIONAL — observability (spec §9). Tracing is off unless explicitly enabled.
# ---------------------------------------------------------------------------
OTEL_ENABLED=false
OTEL_SERVICE_NAME=assesify-backend
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---------------------------------------------------------------------------
# OPTIONAL — Redis (provisioned by docker-compose).
# Note: auth rate limiting is currently in-process and does NOT use Redis, so
# limits are per-worker rather than shared across a multi-worker deployment.
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
